# Mandatory only for the webhook service; offline tests and full-repository scans do not use .env.
# Loaded only by `make serve` (PRSEC_LOAD_DOTENV=1).
GITHUB_WEBHOOK_SECRET=replace-with-a-strong-random-secret
# To rotate, list new and old secrets comma-separated; this overrides GITHUB_WEBHOOK_SECRET:
# GITHUB_WEBHOOK_SECRETS=new-secret,old-secret
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
SEMGREP_TIMEOUT_S=120
HTTP_TIMEOUT_S=25
PRSEC_MAX_ANNOTATIONS=200
# Optional absolute path if semgrep is not on PATH:
# SEMGREP_BIN=/absolute/path/to/.venv/bin/semgrep
